POSTGRES_URL=postgresql://test-user:test-password@test-db:5432/test-db

TEST_POSTGRES_USER=test-user
TEST_POSTGRES_PASSWORD=test-password
TEST_POSTGRES_DB=test-db
TEST_POSTGRES_URL=postgresql://test-user:test-password@test-db:5432/test-db

PORT=8000

KAFKA_BOOTSTRAP_SERVERS=test-kafka:9092
KAFKA_CLIENT_ID=fm26-ingestion
KAFKA_ACKS=all
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_BACKOFF_MS=100
KAFKA_FLUSH_TIMEOUT=5

# Kafka broker
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@test-kafka:9093

KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://test-kafka:9092

KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

STORAGE_LOCATION=local
STORAGE_FILE_PATH=media
STORAGE_ALLOWED_FILE_SIZE=4

FILE_STORAGE=s3
ENVIRONMENT=local
